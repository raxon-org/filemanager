{{$options = options()}}
<?php
namespace Domain\{{php.namespace.host($options.backend.host)}}\Controller\System;

use Package\Raxon\Account\Module\Permission;
use Package\Raxon\Filemanager\Exception\ApplicationNotFoundException;
use Raxon\App;
use Raxon\Exception\ErrorException;
use Raxon\Exception\ObjectException;
use Raxon\Exception\AuthorizationException;
use Raxon\Exception\FileWriteException;

use Raxon\Module\Controller;
use Raxon\Module\File;
use Raxon\Module\Response;
use Raxon\Node\Module\Node;


class Application extends Controller {
    const DIR = __DIR__ . DIRECTORY_SEPARATOR;

    /**
     * @throws ErrorException
     * @throws ObjectException
     * @throws AuthorizationException
     * @throws FileWriteException
     * @throws ApplicationNotFoundException
     */
    public static function open(App $object){
        $role = Permission::controller($object, File::basename(__CLASS__) . ':Filemanager', __FUNCTION__, $user);
        if($role === null){
            throw new AuthorizationException('You are not allowed to access this resource.');
        }
        if(property_exists($role, 'name') && $role->name === 'ROLE_ADMIN'){
            $extension = $object->request('extension');
            $node = new Node($object);
            $class = 'System.Server.Extension';
            $response = $node->record($class, $node->role_system(), [
                'where' => [
                    [
                        'value' => $extension,
                        'attribute' => 'name',
                        'operator' => '===',
                    ]
                ]
            ]);
            $record = $response['node'];
            $class = 'System.Application';
            $data = $node->list($class, $node->role_system(), [
                'where' => [
                    [
                        'value' => $record->uuid,
                        'attribute' => 'extension',
                        'operator' => 'in.array',
                    ]
                ],
                'limit' => '*'
            ]);
            if(empty($data) || empty($data['list'])){
                $name = Application::name(__FUNCTION__ , __CLASS__, '/');
                $object->data('extension', $extension);
                $object->data('message', 'The application for "' . $extension . '" is not installed.');
                $url = Application::locate($object, $name);
                $message = Application::response($object, $url);
                throw new ApplicationNotFoundException($message);
            }
            foreach($data['list'] as $nr => $item){
                if(!empty($_SERVER['HTTP_ORIGIN'])){
                    if(property_exists($item, 'directory')){
                        if(property_exists($item->directory, 'application')){
                            $item->url = $_SERVER['HTTP_ORIGIN'] . '/' . $item->directory->application;
                        }
                    }
                    if(property_exists($item, 'icon')){
                        $item->icon = $_SERVER['HTTP_ORIGIN'] . '/' . $item->icon;
                    }
                }
                elseif(!empty($_SERVER['HTTP_REFERER'])){
                    if(property_exists($item, 'directory')){
                        if(property_exists($item->directory, 'application')){
                            $item->url = $_SERVER['HTTP_REFERER'] . $item->directory->application;
                        }
                    }
                    if(property_exists($item, 'icon')){
                        $item->icon = $_SERVER['HTTP_REFERER'] . $item->icon;
                    }
                }
                $data['list'][$nr] = $item;
            }
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        }
    }
}
