{{$options = options()}}
<?php
namespace Domain\{{php.namespace.host($options.backend.host)}}\Controller\System;

use Package\Raxon\Account\Exception\AuthorizationException;
use Package\Raxon\Account\Module\Permission;

use Package\Raxon\Filemanager\Exception\ApplicationNotFoundException;
use Raxon\App;
use Raxon\Exception\ErrorException;
use Raxon\Exception\ObjectException;
use Raxon\Exception\FileWriteException;
use Raxon\Module\Controller;
use Raxon\Module\File;
use Raxon\Module\Response;
use Raxon\Node\Module\Node;
use Raxon\Node\Core;

class Recycle extends Controller {
    const DIR = __DIR__ . DIRECTORY_SEPARATOR;

    /**
     * @throws ErrorException
     * @throws ObjectException
     * @throws AuthorizationException
     * @throws FileWriteException
     * @throws ApplicationNotFoundException
     */
    public static function bin(App $object){
        $role = Permission::controller($object, File::basename(__CLASS__), __FUNCTION__, $user);
        if($role === null){
            throw new AuthorizationException('You are not allowed to access this resource.');
        }
        if(property_exists($role, 'name') && $role->name === 'ROLE_ADMIN'){
            $node = new Node($object);
            $role = $node->role_system();
            $class = 'System.FileSystem.Recycle';
            $uuid = Core::uuid();
            $target = $object->config('project.volume.dir.recycle') . date('Ymd') . DIRECTORY_SEPARATOR . $uuid . '.data';
            $record = (object) [
                'uuid'=> $uuid,
                'class' => $class,
                'source' => $object->request('url'),
                'target' => $target,
                'user' => $user->uuid,
                'is' => (object) [
                    'created' => microtime(true)
                ]
            ];
            $response = $node->create($class, $role, $record);;
            //for directory go from most deep to least deep and then apply www-data
            d($response);
            ddd($record);

            $data = $object->request();
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        }
    }

    /**
         * @throws ErrorException
         * @throws ObjectException
         * @throws AuthorizationException
         * @throws FileWriteException
         * @throws ApplicationNotFoundException
         */
        public static function restore(App $object){
            $role = Permission::controller($object, File::basename(__CLASS__), __FUNCTION__, $user);
            if($role === null){
                throw new AuthorizationException('You are not allowed to access this resource.');
            }
            if(property_exists($role, 'name') && $role->name === 'ROLE_ADMIN'){
                //uuid = recycle uuid combine with user uuid
                $data = $object->request();
                return new Response(
                    $data,
                    Response::TYPE_JSON
                );
            }
        }
}
