{
    "System": {
      "Route": [
        {
          "#class": "System.Route",
          "name": "api-file-manager-file-open",
          "path": "\/Filemanager\/Open\/",
          "host": "{{options('backend.host')}}",
          "controller": "Domain:{{app.controller.host(options('backend.host'))}}:Controller:System:Application:open",
          "priority": 2001,
          "method": [
            "GET",
            "POST"
          ]
        },
        {
          "#class": "System.Route",
          "name": "api-file-manager-recycle-bin",
          "path": "\/Filemanager\/Recycle\/Bin\/",
          "host": "{{options('backend.host')}}",
          "controller": "Domain:{{app.controller.host(options('backend.host'))}}:Controller:System:Recycle:bin",
          "priority": 2002,
          "method": [
            "DELETE",
            "GET",
            "POST"
          ]
        },
        {
          "#class": "System.Route",
          "name": "api-file-manager-recycle-bin",
          "path": "\/Filemanager\/Recycle\/Restore\/{{literal}}{{$uuid}}{{/literal}}\/",
          "host": "{{options('backend.host')}}",
          "controller": "Domain:{{app.controller.host(options('backend.host'))}}:Controller:System:Recycle:restore",
          "priority": 2003,
          "method": [
            "GET"
          ]
        }
      ]
    }
}