{
    "System": {
      "Route": [
        {
          "#class": "System.Route",
          "name": "api-filemanager-file-open",
          "path": "/Filemanager/Open/",
          "host": "{{options('backend.host')}}",
          "controller": "Domain:{{app.controller.host(options('backend.host'))}}:Controller:Manager:file.open",
          "priority": 2001,
          "method": [
            "GET",
            "POST"
          ]
        }
      ]
    }
}